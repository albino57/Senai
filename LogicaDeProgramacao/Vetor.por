programa
{
	
	funcao inicio()
	{
		cadeia diasDaSemana[7] = {"Domingo","Segunda","Terça","Quarta","Quinta","Sexta","Sábado"}

		escreva("Dias da Semana: ")
		para(inteiro i=0; i<6; i++){
			escreva(diasDaSemana[i])
		}
	}
}
