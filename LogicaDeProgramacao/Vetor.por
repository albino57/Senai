programa
{
	
	funcao inicio()
	{
		const inteiro qtd=7
		cadeia diasDaSemana[qtd] = {"Domingo","Segunda","Terça","Quarta","Quinta","Sexta","Sábado"}

		escreva("Dias da Semana:")
		para(inteiro i=0; i<qtd; i++){
			escreva("\n", diasDaSemana[i])
		}
	}
}
