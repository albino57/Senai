programa {
  funcao inicio() {
    cadeia nome="Rafael"
    inteiro idade=25

    escreva("Nome: ", nome, "\n")
    escreva("Idade: ", idade, "\n")

    imprimir(nome, idade)
    escreva("---------\n")
    
    escreva("Nome: ", nome, "\n")
    escreva("Idade: ", idade, "\n")
  }

  funcao imprimir(cadeia &n, inteiro &i){
    n="Albino"
    i=50
  }
}
